rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}
// Fields:
//   - displayName: string (optional, <= 50 chars)
//   - profileImageUrl: string (optional, <= 500 chars)
//   - bio: string (optional, <= 1000 chars)
//   - tags: list of strings (optional, <= 30 items)
//   - kokoro: string (optional, <= 50 chars)
//   - tokimeki: list of strings (optional, <= 20 items)
//   - privacySettings: map (optional)
//   - createdAt: timestamp (optional)
//   - updatedAt: timestamp (optional)
//
// Collection: threads/{threadId}
// Fields:
//   - title: string (required, 1..100 chars)
//   - authorId: string (required, matches auth.uid)
//   - authorName: string (optional, <= 50 chars)
//   - createdAt: timestamp
//   - latestPostAt: timestamp
//
// Subcollection: threads/{threadId}/posts/{postId}
// Fields:
//   - authorId: string (required, matches auth.uid)
//   - authorName: string (optional, <= 50 chars)
//   - body: string (required, 1..2000 chars)
//   - createdAt: timestamp
//
// Collection: posts/{postId}
// Fields:
//   - authorId: string (required, matches auth.uid)
//   - type: string ('image' | 'novel')
//   - title: string (optional, <= 200 chars)
//   - content: string (optional, <= 20000 chars)
//   - imageUrls: list (optional, <= 10 items)
//   - tags: list (optional, <= 30 items)
//   - likeCount: number
//   - commentCount: number
//   - isR18: bool
//   - createdAt: timestamp
//   - updatedAt: timestamp
//
// Collection: chatRooms/{roomId}
// Fields:
//   - members: list of 2 user UIDs (immutable on update)
//   - lastMessage: string (optional, <= 500 chars)
//   - lastUpdatedAt: timestamp
//
// Subcollection: chatRooms/{roomId}/messages/{messageId}
// Fields:
//   - senderId: string (required, matches auth.uid)
//   - content: string (required, 1..500 chars)
//   - isRead: bool
//   - createdAt: timestamp
//
// Collection: events/{eventId}
// Fields:
//   - organizerId: string (required, matches auth.uid)
//   - title: string (required, <= 200 chars)
//   - description: string (optional, <= 5000 chars)
//   - likeCount: number
//   - commentCount: number
//   - createdAt: timestamp
//   - updatedAt: timestamp
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper & Validator Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidUserProfile(data) {
      return isValidOptionalString(data, 'displayName', 50) &&
             isValidOptionalString(data, 'bio', 1000) &&
             isValidOptionalString(data, 'profileImageUrl', 500) &&
             isValidOptionalString(data, 'kokoro', 50) &&
             isValidOptionalList(data, 'tags', 30) &&
             isValidOptionalList(data, 'tokimeki', 20);
    }

    function isValidThread(data) {
      return data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 100 &&
             isValidOptionalString(data, 'authorName', 50);
    }

    function isValidThreadPost(data) {
      return data.body is string &&
             data.body.size() >= 1 &&
             data.body.size() <= 2000 &&
             isValidOptionalString(data, 'authorName', 50);
    }

    function isValidComment(data) {
      return data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 1000;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        isValidThread(request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.authorId && isValidThread(request.resource.data)) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latestPostAt'])
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;

      match /posts/{postId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          isValidThreadPost(request.resource.data);
        allow update: if isAuthenticated() &&
          request.auth.uid == resource.data.authorId &&
          isValidThreadPost(request.resource.data);
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.authorId ||
          get(/databases/$(database)/documents/threads/$(threadId)).data.authorId == request.auth.uid
        );
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.authorId &&
        isValidOptionalString(request.resource.data, 'title', 200) &&
        isValidOptionalString(request.resource.data, 'content', 20000);
      // Allow owner edits or counter updates (likeCount, commentCount, updatedAt)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;

      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.authorId &&
          isValidComment(request.resource.data);
        allow update: if isAuthenticated() &&
          request.auth.uid == resource.data.authorId &&
          isValidComment(request.resource.data);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;
      }
    }

    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        isValidOptionalString(request.resource.data, 'lastMessage', 500);
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members &&
        isValidOptionalString(request.resource.data, 'lastMessage', 500);

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.members;
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.content is string &&
          request.resource.data.content.size() >= 1 &&
          request.resource.data.content.size() <= 500 &&
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.members &&
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.lastMessage == '' ||
            !('lastUpdatedAt' in get(/databases/$(database)/documents/chatRooms/$(roomId)).data) ||
            request.time >= get(/databases/$(database)/documents/chatRooms/$(roomId)).data.lastUpdatedAt + duration.value(2, 's')
          );
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.organizerId &&
        isValidOptionalString(request.resource.data, 'title', 200) &&
        isValidOptionalString(request.resource.data, 'description', 5000);
      // Allow organizer edits or counter updates (likeCount, commentCount, currentAttendees, updatedAt)
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.organizerId &&
          isValidOptionalString(request.resource.data, 'title', 200) &&
          isValidOptionalString(request.resource.data, 'description', 5000)
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'currentAttendees', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.organizerId;

      match /attendees/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.authorId &&
          isValidComment(request.resource.data);
        allow update: if isAuthenticated() &&
          request.auth.uid == resource.data.authorId &&
          isValidComment(request.resource.data);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;
      }
    }
  }
}
