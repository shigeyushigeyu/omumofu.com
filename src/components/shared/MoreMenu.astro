---
// src/components/shared/MoreMenu.astro
import menuBackground from '~/assets/images/moremenu.png';

const menuItems = [
  { icon: "🏠", label: "ホーム", url: "/" },
  { icon: "🍼", label: "おともだち検索", url: "/users" },
  { icon: "💬", label: "おともだちチャット", url: "/chat" },
  { icon: "🎀", label: "おむもふタイムライン", url: "/timeline" },
  { icon: "🎪", label: "おむもふイベント", url: "/events" },
  { icon: "📝", label: "おむもふ掲示板", url: "/messageboard" },
  { icon: "🖼️", label: "おむもふ画廊", url: "/gallery" },
  { icon: "🎬", label: "おむもふシネマ", url: "/cinema" },
  { icon: "📖", label: "おむもふ文庫", url: "/literature" },
  { icon: "🧷", label: "ABDLとは", url: "/aboutabdl" },
  { icon: "🧸", label: "リトルについて", url: "/aboutlittle" },
];
---

<div class="menu-container" id="moreMenu">
  <button
    class="menu-button"
    id="menuButton"
    aria-label="メニューを開く"
    aria-expanded="false"
    aria-controls="menuList"
  >
    ⋮
  </button>

  <nav
    class="menu-dropdown"
    id="menuList"
    aria-label="メインナビゲーション"
    style={`--menu-bg: url(${menuBackground.src})`}
  >
    <ul class="menu-ul">
      {menuItems.map((item) => (
        <li class="menu-item">
          <a href={item.url} data-astro-reload>
            <span class="menu-icon" aria-hidden="true">{item.icon}</span>
            <span class="menu-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .menu-container {
    position: relative;
    z-index: 9999;
    display: flex;
    align-items: center;
  }

  .menu-button {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    background: #fffafc;
    border: 1.5px dashed #ffc0cb;
    line-height: 1;
    user-select: none;
    color: #a05585;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    padding: 0;
  }

  .menu-button:hover {
    background: #ffe0e6;
    border-color: #f78fb3;
    transform: scale(1.05);
  }

  .menu-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    border: 2px solid #ffc0cb;
    border-radius: 16px;
    box-shadow: 0 10px 28px rgba(160, 85, 133, 0.22);
    z-index: 9998;
    min-width: 250px;
    max-width: calc(100vw - 24px);
    max-height: calc(100vh - 84px);
    overflow-y: auto;
    font-family: 'HachiMaruPop', 'M PLUS Rounded 1c', sans-serif;
    background-color: #ffffff;
    /* 背景画像を薄く（白85%のベールを重ねる）して文字をくっきり読みやすくする */
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 250, 252, 0.88)),
      var(--menu-bg);
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
    backdrop-filter: blur(6px);
  }

  .menu-dropdown.show {
    display: block;
    animation: menuFadeIn 0.18s ease-out;
  }

  @keyframes menuFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .menu-ul {
    list-style: none;
    margin: 0;
    padding: 6px;
  }

  .menu-item {
    border-bottom: 1px dashed rgba(255, 192, 203, 0.55);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    position: relative;
    z-index: 1;
    color: #4a2c3d;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    text-shadow:
      0 1px 2px rgba(255, 255, 255, 0.95),
      0 0 6px rgba(255, 255, 255, 0.9);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .menu-item a:hover {
    background-color: rgba(255, 222, 242, 0.78);
    color: #d36ba6;
    transform: translateX(2px);
  }

  .menu-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    width: 22px;
    text-align: center;
  }

  .menu-label {
    white-space: nowrap;
  }
</style>

<script>
  const btn = document.getElementById("menuButton");
  const list = document.getElementById("menuList");
  const menuContainer = document.getElementById("moreMenu");

  if (btn && list && menuContainer) {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isShown = list.classList.toggle("show");
      btn.setAttribute("aria-expanded", isShown ? "true" : "false");
    });

    document.addEventListener("click", (e) => {
      if (!menuContainer.contains(e.target as Node)) {
        list.classList.remove("show");
        btn.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
