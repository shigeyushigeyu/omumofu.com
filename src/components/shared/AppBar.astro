---
// src/components/shared/AppBar.astro
import MoreMenu from "./MoreMenu.astro";

interface Props {
  title?: string;
}

const { title = "おむもふ" } = Astro.props;
---

<header class="app-bar">
  <div class="app-bar-left">
    <button class="back-button" onclick="history.back()" aria-label="前のページに戻る">←</button>
    <a href="/" class="app-title" title={title}>{title}</a>
  </div>

  <nav class="app-bar-right" aria-label="クイックナビゲーション">
    <a href="/users" class="nav-pill-link" title="おともだち検索">
      <span class="pill-icon" aria-hidden="true">🍼</span>
      <span class="pill-text">さがす</span>
    </a>

    <!-- ログイン状態を表示するコンテナ -->
    <div id="app-bar-auth-status" class="auth-status-container">
      <a href="/login" class="login-btn-link" title="ログイン">
        <span class="pill-icon" aria-hidden="true">🔑</span>
        <span class="pill-text">ログイン</span>
      </a>
    </div>

    <MoreMenu />
  </nav>
</header>

<script>
  import { auth } from '../../lib/firebase';
  import { onAuthStateChanged } from 'firebase/auth';

  const authContainer = document.getElementById('app-bar-auth-status')!;

  onAuthStateChanged(auth, (user) => {
    if (user) {
      const displayName = user.displayName || 'おともだち';

      authContainer.innerHTML = `
        <a href="/chat" class="nav-pill-link chat-pill-link" title="おともだちチャット">
          <span class="pill-icon" aria-hidden="true">💬</span>
          <span class="pill-text">チャット</span>
        </a>
        <a href="/mypage" class="login-btn-link" title="${displayName}のマイページ">
          <span class="pill-icon" aria-hidden="true">🧸</span>
          <span class="pill-text">マイページ</span>
        </a>
      `;
    } else {
      authContainer.innerHTML = `
        <a href="/login" class="login-btn-link" title="ログイン">
          <span class="pill-icon" aria-hidden="true">🔑</span>
          <span class="pill-text">ログイン</span>
        </a>
      `;
    }
  });
</script>

<style>
  .app-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 60px;
    padding: 0 12px;
    background-color: rgba(255, 252, 254, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 2px dotted #ffc0cb;
    box-shadow: 0 2px 12px rgba(240, 120, 180, 0.08);
    z-index: 1000;
    box-sizing: border-box;
  }

  @media screen and (min-width: 640px) {
    .app-bar {
      height: 64px;
      padding: 0 20px;
      gap: 14px;
    }
  }

  .app-bar-left {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .back-button {
    width: 34px;
    height: 34px;
    font-size: 1.05rem;
    background: #fffafc;
    border: 1.5px dashed #ffc0cb;
    cursor: pointer;
    color: #a05585;
    padding: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .back-button:hover {
    background-color: #ffe0e6;
    transform: translateX(-2px);
  }

  .app-title {
    font-size: 1.05rem;
    font-weight: bold;
    color: #d36ba6;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    line-height: 1.3;
    font-family: 'HachiMaruPop', 'M PLUS Rounded 1c', sans-serif;
  }

  @media screen and (min-width: 640px) {
    .app-title {
      font-size: 1.25rem;
    }
  }

  .app-title:hover {
    color: #8cc63f;
  }

  .app-bar-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  @media screen and (min-width: 640px) {
    .app-bar-right {
      gap: 10px;
    }
  }

  .auth-status-container {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media screen and (min-width: 640px) {
    .auth-status-container {
      gap: 10px;
    }
  }

  :global(.nav-pill-link),
  :global(.login-btn-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.78rem;
    padding: 6px 10px;
    border-radius: 9999px;
    transition: all 0.2s ease;
    white-space: nowrap;
    line-height: 1.2;
  }

  :global(.nav-pill-link) {
    color: #d36ba6;
    border: 1.5px dashed #ffc0cb;
    background: #fffafc;
  }

  :global(.nav-pill-link:hover) {
    background-color: #ffe0e6;
    border-color: #f78fb3;
    transform: translateY(-1px);
  }

  :global(.login-btn-link) {
    color: #6ca329;
    border: 1.5px dashed #b5f57c;
    background: #eef9e6;
  }

  :global(.login-btn-link:hover) {
    background-color: #e2f5d3;
    border-color: #8cc63f;
    color: #5a8c1f;
    transform: translateY(-1px);
  }

  :global(.pill-icon) {
    font-size: 0.95rem;
    line-height: 1;
  }

  @media screen and (min-width: 640px) {
    :global(.nav-pill-link),
    :global(.login-btn-link) {
      font-size: 0.88rem;
      padding: 6px 14px;
      gap: 5px;
    }
  }

  /* 画面幅が狭いスマホ（480px以下）ではボタンの文字をコンパクトにし、さらに狭い場合（380px以下）はアイコンのみにしてタイトル潰れを完全防止 */
  @media screen and (max-width: 480px) {
    :global(.nav-pill-link),
    :global(.login-btn-link) {
      padding: 5px 8px;
      font-size: 0.72rem;
    }
  }

  @media screen and (max-width: 390px) {
    :global(.nav-pill-link .pill-text) {
      display: none;
    }
    :global(.nav-pill-link) {
      width: 34px;
      height: 34px;
      padding: 0;
    }
  }
</style>
