---
// src/pages/aboutlittle.astro
import Layout from "../layouts/Layout.astro";
import AppBar from "../components/shared/AppBar.astro";
import { KOKORO_OPTIONS, TOKIMEKI_OPTIONS, KOKORO_CATEGORIES } from "../data/profileOptions";

const pageTitle = "リトルについて・こころのすがた紹介";
const pageDescription = "おむもふコミュニティの「リトル」について、こころのすがた（自認タイプ）とときめきスタイル（フェチ・嗜好）をやさしく紹介します。";
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&family=M+PLUS+Rounded+1c:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>

  <AppBar title="リトルについて" />

  <main class="little-guide-container">
    <header class="little-header">
      <div class="badge-pill">🧸 もう一人のわたしをさがそう</div>
      <h1>きみはどんなリトルちゃん？</h1>
      <p>
        おむもふコミュニティの素敵なおともだち「リトル」について紹介するね。<br />
        いつもの自分とはちょっと違う、ふわふわで自由な自分を見つけにいこうよ🍼✨
      </p>
    </header>

    <section id="label" class="guide-section">
      <h2>🧸 こころのすがた (自認タイプ) 🧸</h2>
      <div class="explanation-box">
        <strong>「こころのすがた」とは？</strong><br />
        リアル（身体の性別）でのあなたと、リトル（心の中の赤ちゃん・子ども）としてのあなたの組み合わせを表現した自認タイプのことです。<br />
        身体は男の子だけど、リトルの時は可愛い女の子になりたい（ファンタジア）、性別の枠にとらわれずに自由でありたい（リリィ、アイリス）など、あなたに一番しっくりくる「こころのすがた」を設定する際の参考にしてみてね。
      </div>

      {KOKORO_CATEGORIES.map((category) => (
        <div class="category-block">
          <h3>{category}</h3>
          <div class="little-card-container">
            {KOKORO_OPTIONS.filter((opt) => opt.category === category).map((opt) => (
              <div class="little-card">
                <p class="card-heading">
                  <span class="name">{opt.label}</span>
                </p>
                <p class="card-desc">{opt.desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section id="element" class="guide-section">
      <h2>✨ ときめきスタイル (フェチ・嗜好) ✨</h2>
      <div class="explanation-box">
        <strong>「ときめきスタイル」とは？</strong><br />
        あなたがリトルとして過ごす中で、どんなことに対して幸せやときめき、または特別なフェチやこだわりを感じるかを表すプレイスタイルのことです。<br />
        いっぱい甘やかされたい（チュア、ケア）、おむつのふわふわ感や可愛いお洋服が大好き（ウェア）、赤ちゃん返り全開になりたい（チャイル）など、あなたの心のエレメント（複数選択可）を見つけるヒントにしてね。
      </div>

      <ul class="element-list">
        {TOKIMEKI_OPTIONS.map((opt) => (
          <li>
            <span class="name">{opt.label}</span>
            <span class="desc">{opt.desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="little-footer">
      <p>どんなリトルちゃんも、みんな大切な「おむもふ」のおともだちだよ！</p>
      <div class="action-buttons">
        <a href="/mypage" class="btn-green">🧸 マイページで自分のタイプを設定する</a>
        <a href="/users" class="btn-pink">🍼 おともだち検索でみんなを探す</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .little-guide-container {
    max-width: 860px;
    margin: 84px auto 48px;
    background-color: rgba(255, 255, 255, 0.95);
    padding: 32px 28px;
    border-radius: 24px;
    box-shadow: 0 8px 24px rgba(180, 120, 140, 0.12);
    border: 3px dashed #ffc0cb;
    box-sizing: border-box;
  }

  .little-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .badge-pill {
    display: inline-block;
    background: #fffafc;
    color: #d36ba6;
    border: 2px dashed #ffc0cb;
    border-radius: 9999px;
    padding: 4px 16px;
    font-size: 0.9rem;
    font-weight: bold;
    margin-bottom: 0.6rem;
  }

  h1 {
    color: #d36ba6;
    text-align: center;
    font-size: 2.2rem;
    font-weight: 700;
    text-shadow: 2px 2px 4px #fff;
    margin: 0 0 16px 0;
  }

  .guide-section {
    margin-bottom: 2.8rem;
  }

  h2 {
    background: linear-gradient(135deg, #fff5f8 0%, #fffef2 100%);
    color: #d36ba6;
    font-size: 1.5rem;
    text-align: center;
    padding: 14px 20px;
    border-radius: 9999px;
    margin-top: 32px;
    margin-bottom: 24px;
    border: 2px solid #ffe0e6;
    box-shadow: 0 4px 10px rgba(240, 120, 180, 0.15);
  }

  h3 {
    color: #a05585;
    font-size: 1.25rem;
    border-bottom: 2px dashed #ffc0cb;
    padding-bottom: 8px;
    margin-top: 28px;
    margin-bottom: 16px;
  }

  .little-card-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }

  .little-card {
    background-color: #fffafc;
    border: 2px solid #ffe0e6;
    border-radius: 16px;
    padding: 18px;
    box-sizing: border-box;
    box-shadow: 0 2px 8px rgba(240, 120, 180, 0.06);
    transition: transform 0.2s, border-color 0.2s;
  }

  .little-card:hover {
    transform: translateY(-4px);
    border-color: #ffc0cb;
  }

  .card-heading {
    margin: 0 0 8px 0;
    text-align: left;
  }

  .little-card .name {
    font-weight: 700;
    color: #d36ba6;
    font-size: 1.05rem;
  }

  .card-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: #6b4c5b;
    text-align: left;
  }

  .element-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  .element-list li {
    background-color: #fafffa;
    border-radius: 14px;
    padding: 14px 18px;
    border: 1.5px solid #d8f5b8;
    border-left: 6px solid #8cc63f;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .element-list .name {
    font-size: 1.05rem;
    font-weight: bold;
    color: #5a8c1f;
  }

  .element-list .desc {
    color: #6b4c5b;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .explanation-box {
    background-color: #fff9fa;
    border: 2px dashed #ffd1dc;
    border-radius: 16px;
    padding: 18px 20px;
    margin: 16px auto 24px;
    font-size: 0.95rem;
    line-height: 1.75;
    text-align: left;
    color: #6b4c5b;
  }

  .explanation-box strong {
    color: #d36ba6;
    display: inline-block;
    margin-bottom: 6px;
    font-size: 1.08rem;
  }

  .little-footer {
    text-align: center;
    margin-top: 2.5rem;
    padding-top: 1.8rem;
    border-top: 2px dashed #ffc0cb;
  }

  .little-footer p {
    font-size: 1.1rem;
    color: #d36ba6;
    font-weight: bold;
    margin-bottom: 1.2rem;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn-green,
  .btn-pink {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 9999px;
    font-weight: bold;
    text-decoration: none;
    font-size: 0.98rem;
    transition: all 0.25s ease;
  }

  .btn-green {
    background: #eef9e6;
    color: #6ca329;
    border: 2px dashed #b5f57c;
  }

  .btn-green:hover {
    background: #e2f5d3;
    transform: translateY(-2px);
  }

  .btn-pink {
    background: #fffafc;
    color: #d36ba6;
    border: 2px dashed #ffc0cb;
  }

  .btn-pink:hover {
    background: #ffe0e6;
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .little-guide-container {
      padding: 20px 16px;
    }
    h1 {
      font-size: 1.75rem;
    }
    h2 {
      font-size: 1.25rem;
    }
  }
</style>
