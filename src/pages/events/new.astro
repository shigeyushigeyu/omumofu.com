---
import Layout from '../../layouts/Layout.astro';
import AppBar from '../../components/shared/AppBar.astro';
import { EventForm } from '../../components/react/EventForm';
import '../../styles/common.css';
import '../../styles/profile.css';
---

<Layout title="イベント・オフ会を作成">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&display=swap" rel="stylesheet" />
  </Fragment>

  <AppBar title="イベント作成" />
  
  <main className="profile-page-container min-h-screen bg-gray-50 pt-24 pb-12">
    <div className="max-w-4xl mx-auto px-4">
      <EventForm client:load />
    </div>
  </main>
</Layout>
