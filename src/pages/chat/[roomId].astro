---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AppBar from '../../components/shared/AppBar.astro';
import { ChatRoom } from '../../components/react/ChatRoom';
import '../../styles/common.css';
import '../../styles/profile.css';

const { roomId } = Astro.params;

if (!roomId) {
  return Astro.redirect('/chat');
}
---

<Layout title="おともだちチャット - おむもふ">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&display=swap" rel="stylesheet" />
  </Fragment>

  <AppBar title="おともだちチャット" />
  
  <main class="profile-page-container">
    <ChatRoom roomId={roomId} client:load />
  </main>
</Layout>
