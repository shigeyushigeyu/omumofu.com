---
// src/pages/literature.astro
import Layout from "../layouts/Layout.astro";
import AppBar from "../components/shared/AppBar.astro";

const pageTitle = "おむもふ文庫";
const pageDescription = "ABDL総合コミュニティのおむもふ文庫ページ。ふわふわでかわいい物語がたくさん！";

const bunkoSections = [
  {
    icon: "🧸",
    title: "おむもふひとくち物語",
    description: "ちいさくて可愛い短編小説の宝箱。読み切りで気軽に楽しめる、夢と優しさが詰まった物語たち。",
    stories: [
      { title: "おむつ後輩さん", link: "/literature/businesswoman" },
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" }
    ],
    bgColor: "#ffe4e1"
  },
  {
    icon: "🌙",
    title: "おむもふ夢綴り",
    description: "長く続く連載作品のページ。ゆらゆら揺れる夢のような物語が、少しずつ綴られていくよ。",
    stories: [
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" }
    ],
    bgColor: "#e0f0ff"
  },
  {
    icon: "🕊️",
    title: "おむもふ詩集",
    description: "ふわふわと舞う言葉たちの庭。リズムと感情が織りなす、やさしい詩とポエムの世界。",
    stories: [
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" }
    ],
    bgColor: "#e6ffed"
  },
  {
    icon: "💌",
    title: "おむもふ思い出綴",
    description: "あたたかくてほっこりする実話体験の記録。読者と作家の心がつながる、やわらかな記憶のページ。",
    stories: [
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" }
    ],
    bgColor: "#fffacd"
  },
  {
    icon: "☁️",
    title: "おむもふ夢空想",
    description: "とろけるような妄想やファンタジーが広がる場所。自由に空想の翼を広げて、あなただけの夢を描いてね。",
    stories: [
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" },
      { title: "準備中です", link: "#" }
    ],
    bgColor: "#f3e8ff"
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>

  <AppBar title="おむもふ文庫" />

  <main class="bunko-container">
    <header class="page-header">
      <h1 class="title-text">
        <span class="icon">🍼</span> おむもふ文庫
      </h1>
      <p class="subtitle">
        ふわふわで、やさしい時間が流れる、あなただけの物語のお部屋📖
      </p>
    </header>

    {bunkoSections.map(section => (
      <section class="bunko-section" style={`--section-bg: ${section.bgColor};`}>
        <header class="section-header">
          <div class="icon">{section.icon}</div>
          <h2>{section.title}</h2>
        </header>
        <p class="description">{section.description}</p>
        
        <ul class="story-list">
          {section.stories.map(story => (
            <li>
              <a href={story.link}>
                <span class="book-icon">📖</span>
                <span>{story.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <footer class="page-footer">
      <p>おむもふ | ABDL総合コミュニティ 💖</p>
    </footer>
  </main>
</Layout>

<style>
  .bunko-container {
    max-width: 900px;
    margin: 84px auto 48px;
    padding: 2rem 1.5rem;
    box-sizing: border-box;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(212, 175, 175, 0.1);
    border: 3px dashed #ffc0cb;
  }

  .title-text {
    font-size: 2.5rem;
    color: #d36ba6;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    text-shadow: 2px 2px 0 #ffe4e1;
  }

  .title-text .icon {
    font-size: 2.8rem;
    display: inline-block;
    animation: wiggle 2.5s infinite;
  }

  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  .subtitle {
    font-size: 1.05rem;
    color: #7d5b6b;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .bunko-section {
    background-color: #ffffff;
    border-radius: 20px;
    padding: 1.8rem 2rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 8px 20px rgba(212, 175, 175, 0.18);
    border: 2.5px dashed #ffc0cb;
    border-top: 10px solid var(--section-bg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .bunko-section:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(212, 175, 175, 0.28);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
    border-bottom: 2px dotted #f0d0d0;
    padding-bottom: 0.8rem;
  }

  .section-header .icon {
    font-size: 2.2rem;
    line-height: 1;
    transform: rotate(-10deg);
  }

  .section-header h2 {
    color: #a05585;
    font-size: 1.5rem;
    margin: 0;
    padding: 0;
    background: none;
    box-shadow: none;
  }

  .description {
    font-size: 0.98rem;
    margin-bottom: 1.5rem;
    padding-left: 1rem;
    border-left: 4px solid var(--section-bg);
    text-align: left;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .story-list li a {
    background-color: var(--section-bg);
    padding: 0.85rem 1.2rem;
    border-radius: 12px;
    color: #5c524e;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .story-list li a:hover {
    transform: scale(1.03);
    background-color: #ffffff;
    color: #d36ba6;
    border: 2px solid var(--section-bg);
  }

  .book-icon {
    font-size: 1.2rem;
    transition: transform 0.3s ease;
  }

  .story-list li a:hover .book-icon {
    transform: rotate(15deg);
  }

  .page-footer {
    text-align: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px dashed #ffc0cb;
  }

  .page-footer p {
    color: #d36ba6;
    font-weight: bold;
  }
</style>
