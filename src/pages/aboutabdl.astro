---
// src/pages/aboutabdl.astro
import Layout from "../layouts/Layout.astro";
import AppBar from "../components/shared/AppBar.astro";
import AdultBabyAB from '../assets/images/aboutabdl/adultbabyab.png';
import DiaperLoverDL from '../assets/images/aboutabdl/diaperloverdl.png';
import TBDL from '../assets/images/aboutabdl/tbdl.png';
import Diaper from '../assets/images/aboutabdl/diaper.png';
import Babywear from '../assets/images/aboutabdl/Babywear.png';
import Care from '../assets/images/aboutabdl/care.png';
import Restroom from '../assets/images/aboutabdl/restroom.png';

const pageTitle = "ABDLってなあに？";
const pageDescription = "ABDL（Adult Baby Diaper Lover）やリトルのライフスタイル・よく使うアイテム・楽しみ方についてやさしく解説するページです。";
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&family=M+PLUS+Rounded+1c:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>

  <AppBar title="ABDLとは？" />

  <main class="abdl-guide-container">
    <!-- ヒーローヘッダー -->
    <header class="page-header">
      <div class="badge-pill">🍼 はじめてのおともだちへ</div>
      <h1 class="title-text">ABDLってなあに？</h1>
      <p class="intro-text">
        <strong>ABDL（Adult Baby / Diaper Lover）</strong>とは、大人になっても赤ちゃんや小さな子どものように無邪気に過ごしたり、ふわふわのおむつ（ダイパー）に包まれて癒やしや安心感・ときめきを感じるライフスタイルや嗜好のことだよ🧸✨
      </p>
    </header>

    <!-- 1. ABDLの3つのスタイル -->
    <section class="info-section">
      <h2 class="section-title">
        <span class="num-circle">1</span>
        <span>ABDLってどんなスタイルがあるの？</span>
      </h2>
      <p class="section-lead">
        楽しみ方や感じ方はおともだち一人ひとり違うよ。どれかひとつだけでも、全部あわさっていても、きみらしくて素敵なことなんだよ🎀
      </p>
      <div class="card-grid three-cols">
        <div class="content-card">
          <div class="card-tag">👶 おとなの赤ちゃん</div>
          <h3>Adult Baby (AB)</h3>
          <p>
            赤ちゃんのように甘えたり、ごろごろしたり、ロンパースやよだれかけ・哺乳瓶・おしゃぶりなどのベビーグッズを使って過ごすスタイルだよ。日常のプレッシャーを忘れて、小さな「リトル」に戻れる癒やしの時間を楽しんでいるよ。
          </p>
          <div class="image-frame">
            <img src={AdultBabyAB.src} alt="Adult Baby (AB) のイラスト" class="image" loading="lazy" />
          </div>
        </div>

        <div class="content-card">
          <div class="card-tag">🧷 おむつ愛好家</div>
          <h3>Diaper Lover (DL)</h3>
          <p>
            おむつを身につける感触や見た目、おむつの中で過ごす安心感・解放感が大好きなスタイルだよ。赤ちゃんになりきらなくても、「おむつそのものが好き！」というおともだちもたくさんいるよ。
          </p>
          <div class="image-frame">
            <img src={DiaperLoverDL.src} alt="Diaper Lover (DL) のイラスト" class="image" loading="lazy" />
          </div>
        </div>

        <div class="content-card">
          <div class="card-tag">🧸 リトル＆ケアギバー</div>
          <h3>Little / Caregiver</h3>
          <p>
            赤ちゃんよりも少しお兄さん・お姉さんな子ども心を持つ「リトル（Little）」や、おむつ替えやミルクで優しくお世話をしてあげる「ママ・パパ（Caregiver / お世話係）」など、いろんな関係性があるよ。
          </p>
          <div class="image-frame">
            <img src={TBDL.src} alt="リトル＆ケアギバーのイラスト" class="image" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. ABDLのすごしかた -->
    <section class="info-section">
      <h2 class="section-title">
        <span class="num-circle">2</span>
        <span>ABDLのやさしい過ごし方</span>
      </h2>
      <div class="lifestyle-content">
        <div class="video-wrapper lifestyle-video">
          <video
            src="/assets/videos/Lifestyle.mp4"
            autoplay
            muted
            loop
            playsinline
            controls
          ></video>
        </div>
        <ul class="custom-list">
          <li>
            <strong>ふわふわの安心感に包まれる時間</strong><br />
            おむつを着けて過ごすことや、お漏らし・おねしょをすることも、ここでは自然なこととして優しく受け入れられているよ。
          </li>
          <li>
            <strong>心の休息・セルフケアとして</strong><br />
            ドキドキするフェチとしてはもちろん、「頑張りすぎた大人の自分を休ませる癒やし」や「ありのままの自分らしさ」として楽しむおともだちが多いよ。
          </li>
          <li>
            <strong>おむつ替えやだっこは信頼のしるし</strong><br />
            パートナーやおともだちとのおむつ交換・お世話ごっこは、愛情と安心を確かめあう大切なコミュニケーションのひとつだよ。
          </li>
          <li>
            <strong>自分のペースで楽しめる</strong><br />
            週末だけリトルになる子も、毎日おむつで過ごす子も、トイトレごっこを楽しむ子も、みんな自分のペースで無理なく楽しんでいるよ。
          </li>
        </ul>
      </div>
    </section>

    <!-- 3. よく使うおきにいりアイテム -->
    <section class="info-section">
      <h2 class="section-title">
        <span class="num-circle">3</span>
        <span>よく使うおきにいりアイテム</span>
      </h2>
      <p class="section-lead">
        リトルちゃんやおむつ好きさんが愛用している、かわいいアイテムたちを紹介するね🍼
      </p>
      <div class="card-grid four-cols">
        <div class="content-card item-card">
          <h4>🧷 おむつ</h4>
          <p class="item-desc">可愛い柄つきのABDL専用おむつ（ABU等）や、ふわふわの紙おむつ・布おむつ</p>
          <div class="image-frame small">
            <img src={Diaper.src} alt="おむつのイラスト" class="image" loading="lazy" />
          </div>
        </div>

        <div class="content-card item-card">
          <h4>👗 ベビー服・小物</h4>
          <p class="item-desc">大人サイズのロンパース、スタイ（よだれかけ）、哺乳瓶、おしゃぶり</p>
          <div class="image-frame small">
            <img src={Babywear.src} alt="ベビー服のイラスト" class="image" loading="lazy" />
          </div>
        </div>

        <div class="content-card item-card">
          <h4>🧸 ケア・おねんね用品</h4>
          <p class="item-desc">おむつカバー、防水シーツ、ベビーパウダー、大好きなぬいぐるみ</p>
          <div class="image-frame small">
            <img src={Care.src} alt="ケア用品のイラスト" class="image" loading="lazy" />
          </div>
        </div>

        <div class="content-card item-card">
          <h4>🚽 トイトレグッズ</h4>
          <p class="item-desc">おまるやトレーニングパンツ、できたねシールなどのトイトレ遊びグッズ</p>
          <div class="image-frame small">
            <img src={Restroom.src} alt="トイトレグッズのイラスト" class="image" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- 4. おむもふでできること -->
    <section class="info-section">
      <h2 class="section-title">
        <span class="num-circle">4</span>
        <span>「おむもふ」でできること</span>
      </h2>
      <p class="section-lead">
        おむもふでは、同じ趣味やこころのすがたを持つおともだちと安心して繋がれるお部屋を用意しているよ🌈
      </p>
      <div class="feature-links-grid">
        <a href="/aboutlittle" class="feature-link-card">
          <span class="feature-emoji">🧸</span>
          <div>
            <strong>リトルについて知る</strong>
            <span>「こころのすがた」や「ときめきスタイル」を見つけよう</span>
          </div>
        </a>
        <a href="/users" class="feature-link-card">
          <span class="feature-emoji">🍼</span>
          <div>
            <strong>おともだち検索</strong>
            <span>プロフィールやスタイルが合うおともだちを探してチャットしよう</span>
          </div>
        </a>
        <a href="/timeline" class="feature-link-card">
          <span class="feature-emoji">🎀</span>
          <div>
            <strong>おむもふタイムライン</strong>
            <span>かわいいおむつ姿やイラストを投稿して「いいね」しあおう</span>
          </div>
        </a>
        <a href="/messageboard" class="feature-link-card">
          <span class="feature-emoji">📝</span>
          <div>
            <strong>おむもふ掲示板＆イベント</strong>
            <span>気になる話題でおしゃべりしたり、オフ会・イベントを探そう</span>
          </div>
        </a>
      </div>
    </section>

    <!-- 5. コミュニティからのおやくそく＆メッセージ -->
    <section class="info-section community-message">
      <h2 class="section-title" style="justify-content: center;">
        <span class="num-circle">5</span>
        <span>おむもふからのおやくそく 💖</span>
      </h2>
      <p>
        ここは、ABDLやリトルのおともだちみんなが安心して自分らしくいられる秘密のお部屋です。<br />
        性別・スタイル・歴の長さを問わず、お互いの「好き」を尊重しあいながら仲よく遊ぼうね。
      </p>
      <div class="final-message">
        <strong>みんなの笑顔と「もふもふ」があふれる優しいコミュニティにしようね🍼✨</strong>
        <small class="r18-note">
          ※当サイトは成人向け（18歳以上対象）のコミュニティです。18歳未満の方の閲覧・ご利用は固くお断りいたします。
        </small>
      </div>
    </section>
  </main>
</Layout>

<style>
  .abdl-guide-container {
    max-width: 900px;
    margin: 84px auto 48px;
    padding: 2rem 1.5rem;
    box-sizing: border-box;
  }

  /* ヘッダー */
  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .badge-pill {
    display: inline-block;
    background: #fffafc;
    color: #d36ba6;
    border: 2px dashed #ffc0cb;
    border-radius: 9999px;
    padding: 4px 16px;
    font-size: 0.9rem;
    font-weight: bold;
    margin-bottom: 0.75rem;
  }

  .title-text {
    font-size: 2.4rem;
    color: #d36ba6;
    margin: 0 0 1.2rem 0;
    text-shadow: 2px 2px 0 #fff, -2px -2px 0 #fff;
  }

  .intro-text {
    font-size: 1.05rem;
    max-width: 720px;
    margin: 0 auto;
    background: #fffafc;
    padding: 1.4rem 1.6rem;
    border-radius: 18px;
    box-shadow: 0 4px 12px rgba(240, 120, 180, 0.1);
    border: 2px dashed #ffc0cb;
    color: #6b4c5b;
    line-height: 1.85;
  }

  /* 各セクション共通 */
  .info-section {
    background: rgba(255, 255, 255, 0.95);
    padding: 2rem 1.8rem;
    border-radius: 22px;
    margin-bottom: 2.2rem;
    box-shadow: 0 6px 18px rgba(180, 120, 140, 0.1);
    border: 2px dashed #ffe0e6;
  }

  .section-title {
    font-size: 1.45rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem 0;
    padding: 0.8rem 1.2rem;
    border-radius: 9999px;
    background: #fff5f8;
    color: #a05585;
    box-shadow: 0 3px 8px rgba(240, 120, 180, 0.15);
    text-align: left;
  }

  .section-lead {
    margin: 0 0 1.4rem 0;
    font-size: 0.98rem;
    color: #7d5b6b;
  }

  .num-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #f78fb3;
    color: #ffffff;
    font-size: 1.05rem;
    border-radius: 50%;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* カードグリッド */
  .card-grid {
    display: grid;
    gap: 1.25rem;
  }
  .three-cols {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .four-cols {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .content-card {
    background-color: #fffafc;
    padding: 1.35rem;
    border-radius: 18px;
    border: 2px solid #ffe0e6;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .content-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 18px rgba(255, 192, 203, 0.3);
    border-color: #ffc0cb;
  }

  .card-tag {
    align-self: center;
    background: #eef9e6;
    color: #6ca329;
    border: 1px dashed #b5f57c;
    font-size: 0.78rem;
    font-weight: bold;
    padding: 2px 12px;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .content-card h3 {
    margin: 0 0 0.6rem 0;
    text-align: center;
    color: #d36ba6;
    font-size: 1.2rem;
  }

  .content-card p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #6b4c5b;
    text-align: left;
    margin: 0 0 1rem 0;
    flex: 1;
  }

  .content-card.item-card h4 {
    margin: 0 0 0.5rem 0;
    text-align: center;
    color: #d36ba6;
    font-size: 1.08rem;
  }

  .content-card.item-card .item-desc {
    font-size: 0.85rem;
    text-align: center;
    min-height: 44px;
    margin-bottom: 0.8rem;
  }

  .image-frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    border: 2px dashed #ffc0cb;
    margin-top: auto;
  }

  .image-frame.small {
    aspect-ratio: 4 / 3;
  }

  .image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* 2. 生活スタイル */
  .lifestyle-content {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1.75rem;
    align-items: center;
  }

  @media (max-width: 768px) {
    .lifestyle-content {
      grid-template-columns: 1fr;
    }
    .abdl-guide-container {
      padding: 1.25rem 1rem;
    }
    .info-section {
      padding: 1.5rem 1.2rem;
    }
    .title-text {
      font-size: 1.9rem;
    }
    .section-title {
      font-size: 1.2rem;
    }
  }

  .video-wrapper {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 16px;
    border: 3px dashed #ffc0cb;
    background-color: #fffafc;
  }

  .lifestyle-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .custom-list li {
    padding: 0.85rem 1rem 0.85rem 2.6rem;
    position: relative;
    background: #fffafc;
    border: 1.5px solid #ffe0e6;
    border-radius: 14px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #6b4c5b;
    text-align: left;
  }

  .custom-list li strong {
    color: #d36ba6;
  }

  .custom-list li::before {
    content: '🍼';
    position: absolute;
    left: 0.8rem;
    top: 0.85rem;
    font-size: 1.2rem;
  }

  /* 4. おむもふ機能リンク */
  .feature-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .feature-link-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 1rem 1.2rem;
    background: linear-gradient(135deg, #fffafc 0%, #f7fdec 100%);
    border: 2px dashed #ffc0cb;
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .feature-link-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(240, 120, 180, 0.25);
    border-color: #f78fb3;
  }

  .feature-emoji {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .feature-link-card strong {
    display: block;
    color: #d36ba6;
    font-size: 1.02rem;
    margin-bottom: 2px;
  }

  .feature-link-card span {
    display: block;
    color: #7d5b6b;
    font-size: 0.83rem;
    line-height: 1.4;
  }

  /* 5. コミュニティメッセージ */
  .community-message {
    background: linear-gradient(135deg, #fff5f8 0%, #f3fdec 100%);
    border-color: #ffc0cb;
    text-align: center;
  }

  .final-message {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 2px dashed #ffc0cb;
    font-size: 1.05rem;
  }

  .final-message strong {
    color: #d36ba6;
    display: block;
    margin-bottom: 0.6rem;
  }

  .r18-note {
    display: block;
    color: #e57373;
    font-size: 0.82rem;
    font-weight: bold;
  }
</style>
